# Paper-only Alpaca credentials. Never point these at live trading.
# Do not reuse old Tradier tokens. This lab does not read TRADIER_* variables.
#
# LIVE_TRADING is hardcoded False in tradinglab/config.py and cannot be
# enabled via environment variables.

APCA_API_KEY_ID=replace-with-alpaca-paper-key-id
APCA_API_SECRET_KEY=replace-with-alpaca-paper-secret

# Optional starting equity used when the paper API is not contacted.
PAPER_EQUITY=100000
